# Jira REST API Integration Configuration
# For Jira Cloud: JIRA_URL=https://your-domain.atlassian.net, JIRA_EMAIL=your-email@company.com, JIRA_API_TOKEN=your-atlassian-api-token
# For Jira Server / Data Center: JIRA_URL=https://jira.company.com, JIRA_PAT=your-personal-access-token

JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-atlassian-api-token
# JIRA_PAT=your-personal-access-token
